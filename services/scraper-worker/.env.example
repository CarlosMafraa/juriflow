# =============================================================================
# @juriflow/scraper-worker — variáveis de ambiente
# Copie para `.env` (nunca versionado) e preencha com valores reais.
# Roda na VPS, nunca no frontend. NUNCA commitar a service_role key.
# =============================================================================

# Supabase Cloud (não o local) — projeto de produção.
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-cloud-service-role-key

# WAHA (container na mesma VPS — ver infra/vps/docker-compose.yml). Sessão por
# espaço (RN seção 22): nome calculado a partir do space_id, não é mais fixo.
WAHA_BASE_URL=http://waha:3000
WAHA_API_KEY=replace-with-waha-api-key
# Intervalo (ms) do polling de conexão/QR/status de whatsapp_sessions.
WAHA_SESSION_POLL_MS=5000

# Fonte Projudi/TJAM.
TJAM_PROJUDI_BASE_URL=https://projudi-consulta.tjam.jus.br/processo/consultaPublicaNova.do?actionType=iniciar
# false = navegador visível (Xvfb) — usar se o modo headless for bloqueado pelo anti-bot.
SCRAPER_HEADLESS=true
# Intervalo mínimo (ms) entre a coleta de cada processo, para não sobrecarregar a fonte.
SCRAPER_THROTTLE_MS=4000

# Cron da rotina diária (RN seção 13 — padrão 08:00).
DAILY_CHECK_CRON=0 8 * * *
HTTP_PORT=3000
LOG_LEVEL=info
