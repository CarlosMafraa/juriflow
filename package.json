{
  "name": "juriflow",
  "version": "0.1.0",
  "private": true,
  "description": "JuriFlow — plataforma SaaS multi-tenant para gestão e acompanhamento de processos jurídicos.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.11.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "tsc -b && npm run build --workspace apps/web --if-present",
    "typecheck": "tsc -b --force",
    "lint": "eslint . && npm run lint --workspace apps/web --if-present",
    "format": "prettier --write \"**/*.{ts,js,json,md,html,scss,css,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,md,html,scss,css,yml,yaml}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:web": "npm run test --workspace apps/web --if-present",
    "collector:tick": "tsc -b packages/collectors-core packages/movement-normalizer packages/collector-engine && node scripts/collector-tick.mjs",
    "datajud:smoke": "tsc -b packages/collectors-core packages/movement-normalizer packages/collector-engine packages/adapter-datajud && node scripts/datajud-smoke.mjs",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:diff": "supabase db diff",
    "db:test": "supabase test db",
    "dev": "npm run dev --workspace apps/web"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@supabase/supabase-js": "^2.45.4",
    "eslint": "^9.13.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "supabase": "^1.207.9",
    "typescript": "~5.5.4",
    "typescript-eslint": "^8.11.0",
    "vitest": "^2.1.4"
  }
}
