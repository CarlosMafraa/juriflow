# =============================================================================
# infra/vps/.env — usado pelo docker-compose (substituição de variáveis) E
# passado ao container scraper-worker via `env_file`. Copie para `.env` no
# servidor do worker — em casa ou VPS (nunca versionado). Mapa completo das
# variáveis: docs/DEPLOY.md.
# =============================================================================

# Supabase Cloud (produção — não o stack local).
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-cloud-service-role-key

# WAHA — mesma chave usada pelo container waha (WHATSAPP_API_KEY) e pelo worker.
# Sessão por espaço (RN seção 22): nome calculado a partir do space_id.
WAHA_API_KEY=replace-with-a-strong-random-key
WAHA_BASE_URL=http://waha:3000
WAHA_SESSION_POLL_MS=5000

# O firewall do TJAM rejeita headless: false (no container roda sob Xvfb).
SCRAPER_HEADLESS=false
# Pausa entre processos na rotina diária. Alta de propósito: o firewall do
# TJAM bloqueia consultas seguidas (regra F4).
SCRAPER_THROTTLE_MS=60000

DAILY_CHECK_CRON=0 8 * * *
# Parabéns de aniversário (equipe e clientes): de hora em hora das 9h às 20h.
BIRTHDAY_CRON=0 9-20 * * *
# Fuso do cron (o container roda em UTC).
DAILY_CHECK_TIMEZONE=America/Manaus
# Intervalo (ms) do polling dos pedidos de "consultar agora" feitos no app.
CHECK_REQUEST_POLL_MS=10000
HTTP_PORT=3000
# Anti-bloqueio do WhatsApp (docs do WAHA): pausa aleatória entre mensagens.
WHATSAPP_MIN_INTERVAL_MS=30000
WHATSAPP_MAX_INTERVAL_MS=60000
# Monitor externo (ex.: Healthchecks.io): pingado a cada minuto; se parar,
# o monitor avisa que o worker caiu. Vazio = sem alerta externo.
HEALTHCHECK_PING_URL=
LOG_LEVEL=info
