# =============================================================================
# infra/vps/.env — usado pelo docker-compose (substituição de variáveis) E
# passado ao container scraper-worker via `env_file`. Copie para `.env` na
# VPS (nunca versionado).
# =============================================================================

# Supabase Cloud (produção — não o stack local).
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-cloud-service-role-key

# WAHA — mesma chave usada pelo container waha (WHATSAPP_API_KEY) e pelo worker.
# Sessão por espaço (RN seção 22): nome calculado a partir do space_id.
WAHA_API_KEY=replace-with-a-strong-random-key
WAHA_BASE_URL=http://waha:3000
# Tag da imagem do WAHA (>= 2026.6.1 para sessões ilimitadas no Core).
WAHA_IMAGE_TAG=latest-2026.9.1
WAHA_SESSION_POLL_MS=5000

TJAM_PROJUDI_BASE_URL=https://projudi-consulta.tjam.jus.br/processo/consultaPublicaNova.do?actionType=iniciar
SCRAPER_HEADLESS=true
SCRAPER_THROTTLE_MS=4000

DAILY_CHECK_CRON=0 8 * * *
# Fuso do cron (o container roda em UTC).
DAILY_CHECK_TIMEZONE=America/Manaus
# Intervalo (ms) do polling dos pedidos de "consultar agora" feitos no app.
CHECK_REQUEST_POLL_MS=10000
HTTP_PORT=3000
LOG_LEVEL=info
