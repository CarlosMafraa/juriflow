# =============================================================================
# JuriFlow — exemplo de variáveis de ambiente
# Copie para `.env` (nunca versionado) e preencha com valores reais.
# NUNCA faça commit de `.env`, tokens, senhas, API keys ou credenciais.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase (obtidos com `supabase status` após `npm run db:start`)
# -----------------------------------------------------------------------------
SUPABASE_URL=http://127.0.0.1:55321
SUPABASE_ANON_KEY=replace-with-local-anon-key
# Somente no backend / jobs. NUNCA expor no frontend (bundle Angular).
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres

# -----------------------------------------------------------------------------
# Frontend (apps/web) — apenas valores públicos podem entrar aqui
# -----------------------------------------------------------------------------
WEB_SUPABASE_URL=http://127.0.0.1:55321
WEB_SUPABASE_ANON_KEY=replace-with-local-anon-key
WEB_APP_NAME=JuriFlow

# -----------------------------------------------------------------------------
# Observabilidade
# -----------------------------------------------------------------------------
LOG_LEVEL=info
# Header usado para correlação de requisições (request id)
REQUEST_ID_HEADER=x-request-id

# -----------------------------------------------------------------------------
# FASES FUTURAS — apenas placeholders. Não usados na Fase 2.
# Coletores (DataJud / Projudi-TJAM / API de tribunal / scraper) — Fase de Acompanhamento
# -----------------------------------------------------------------------------
# DATAJUD_API_BASE_URL=
# DATAJUD_API_KEY=
# COLLECTOR_WORKER_URL=

# WAHA (integração WhatsApp) — Fase WAHA
# WAHA_BASE_URL=
# WAHA_API_KEY=
# WAHA_WEBHOOK_SECRET=
